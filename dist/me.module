#!name=个人规则
#!desc=个人覆盖规则 | 优先级最高 | 规则 3 条 | 更新 2026-10-30
#!category=分流

[Rule]
DOMAIN-SUFFIX,aiifan.pp.ua,DIRECT
DOMAIN-SUFFIX,aiifan.dpdns.org,DIRECT
DOMAIN-SUFFIX,yamu.com,DIRECT

# --- 误判纠正示例: 某国内域名被分到代理，强制直连 ---
# DOMAIN-SUFFIX,example.com.cn,DIRECT

# --- 某国内备案站想走代理 ---
# DOMAIN-SUFFIX,some.cn.site,PROXY

# --- 追加屏蔽 ---
# DOMAIN-SUFFIX,ads.example.com,REJECT

# --- 某域名想单独走某个分支(比如 Telegram 图床) ---
# DOMAIN-SUFFIX,imgbox.com,PROXY
